# Copy one of the profiles from profiles/ to .env:
#   cp profiles/small_pi.env .env   # 1-2GB Raspberry Pi / low-resource devices
#   cp profiles/big_pi.env .env     # 4GB+ Raspberry Pi (4GB / 8GB models)
#   cp profiles/server.env .env     # 8GB+ Servers / high-ingestion hosts
#
# Or override individual values directly here:
VM_MEMORY_LIMIT=96M
VM_ALLOWED_PERCENT=40
VM_MAX_CONCURRENT_REQUESTS=2
VM_RETENTION_PERIOD=6

GRAFANA_MEMORY_LIMIT=200M
GRAFANA_ALERTING_ENABLED=false
GRAFANA_SERVER_CONNECTIONS_MAX=10

VM_PORT=8428
GRAFANA_PORT=3000
