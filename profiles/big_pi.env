# ==============================================================================
# Profile: big_pi (4GB+ RAM, including 4GB and 8GB models)
# Hardware: Raspberry Pi 5 / 4 (4GB, 8GB, 16GB), Intel N100 / x86 mini-PCs
# Total stack memory footprint: ~1.5GB limit (actual steady state ~400MB-550MB)
# Enables full tri-signal OTLP stack (OTel Collector + Metrics + Logs + Traces).
# ==============================================================================

COMPOSE_PROFILES=full

# --- OTel Collector ---
OTELCOL_MEMORY_LIMIT=160M
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- VictoriaMetrics ---
VM_MEMORY_LIMIT=512M
VM_ALLOWED_PERCENT=50
VM_MAX_CONCURRENT_REQUESTS=4
VM_RETENTION_PERIOD=12

# --- VictoriaLogs ---
VL_MEMORY_LIMIT=128M
VL_ALLOWED_PERCENT=20
VL_RETENTION_PERIOD=7d
VL_PORT=9428

# --- Grafana Tempo ---
TEMPO_MEMORY_LIMIT=192M
TEMPO_PORT=3200

# --- Grafana ---
GRAFANA_MEMORY_LIMIT=512M
GRAFANA_ALERTING_ENABLED=true
GRAFANA_SERVER_CONNECTIONS_MAX=50
GRAFANA_PLUGINS=victoriametrics-logs-datasource

# --- Ports ---
VM_PORT=8428
GRAFANA_PORT=3000
