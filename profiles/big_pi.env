# ==============================================================================
# Profile: big_pi (4GB+ RAM, including 4GB and 8GB models)
# Hardware: Raspberry Pi 5 / 4 (4GB, 8GB, 16GB), Intel N100 / x86 mini-PCs
# Total stack memory footprint: ~1GB limit
# Allows active Grafana alerting, larger in-memory cache, and higher query concurrency.
# ==============================================================================

# --- VictoriaMetrics ---
VM_MEMORY_LIMIT=512M
VM_ALLOWED_PERCENT=50
VM_MAX_CONCURRENT_REQUESTS=4
VM_RETENTION_PERIOD=12

# --- Grafana ---
GRAFANA_MEMORY_LIMIT=512M
GRAFANA_ALERTING_ENABLED=true
GRAFANA_SERVER_CONNECTIONS_MAX=50

# --- Ports ---
VM_PORT=8428
GRAFANA_PORT=3000
