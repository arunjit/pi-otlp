# ==============================================================================
# Profile: Server (8GB+ RAM, Production or High-Ingestion Host)
# Total stack memory footprint: ~4GB limit
# Optimized for higher cardinality, large dashboards, and long retention.
# ==============================================================================

COMPOSE_PROFILES=full

# --- OTel Collector ---
OTELCOL_MEMORY_LIMIT=256M
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- VictoriaMetrics ---
VM_MEMORY_LIMIT=2048M
VM_ALLOWED_PERCENT=60
VM_MAX_CONCURRENT_REQUESTS=8
VM_RETENTION_PERIOD=24

# --- VictoriaLogs ---
VL_MEMORY_LIMIT=512M
VL_ALLOWED_PERCENT=30
VL_RETENTION_PERIOD=30d
VL_PORT=9428

# --- Grafana Tempo ---
TEMPO_MEMORY_LIMIT=512M
TEMPO_PORT=3200

# --- Grafana ---
GRAFANA_MEMORY_LIMIT=1024M
GRAFANA_ALERTING_ENABLED=true
GRAFANA_SERVER_CONNECTIONS_MAX=100
GRAFANA_PLUGINS=victoriametrics-logs-datasource

# --- Ports ---
VM_PORT=8428
GRAFANA_PORT=3000
