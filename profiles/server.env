# ==============================================================================
# Profile: Server (8GB+ RAM, Production or High-Ingestion Host)
# Total stack memory footprint: ~3GB limit
# Optimized for higher cardinality, large dashboards, and long retention.
# ==============================================================================

# --- VictoriaMetrics ---
VM_MEMORY_LIMIT=2048M
VM_ALLOWED_PERCENT=60
VM_MAX_CONCURRENT_REQUESTS=8
VM_RETENTION_PERIOD=24

# --- Grafana ---
GRAFANA_MEMORY_LIMIT=1024M
GRAFANA_ALERTING_ENABLED=true
GRAFANA_SERVER_CONNECTIONS_MAX=100

# --- Ports ---
VM_PORT=8428
GRAFANA_PORT=3000
