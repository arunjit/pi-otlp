# ==============================================================================
# Profile: small_pi (1-2GB RAM)
# Hardware: Raspberry Pi 3/4/5 (1GB or 2GB), Pi Zero 2W, low-memory edge devices
# Total stack memory footprint: ~296MB limit (actual steady state ~160MB-180MB)
# Leaves ~70% of memory for OS kernel, systemd, and disk caching.
# ==============================================================================

# --- VictoriaMetrics ---
VM_MEMORY_LIMIT=96M
VM_ALLOWED_PERCENT=40
VM_MAX_CONCURRENT_REQUESTS=2
VM_RETENTION_PERIOD=6

# --- Grafana ---
GRAFANA_MEMORY_LIMIT=200M
GRAFANA_ALERTING_ENABLED=false
GRAFANA_SERVER_CONNECTIONS_MAX=10

# --- Ports ---
VM_PORT=8428
GRAFANA_PORT=3000
